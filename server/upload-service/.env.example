# ===== 参考文件（图片 / 音频）上传代理服务配置 =====
# 复制本文件为 .env 并填写真实值。切勿把 .env 提交到 git！

# 服务监听端口（Nginx 反代到这里）
PORT=3100
# 监听地址：默认 127.0.0.1，只允许本机 Nginx 反代访问（更安全）。
# 如果想直接公网访问（不推荐）改成 0.0.0.0。
HOST=127.0.0.1

# 腾讯云 COS 密钥（在腾讯云「访问管理 CAM -> 密钥管理」获取；建议用子账号最小权限密钥）
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey

# COS 存储桶名（带 APPID），例如 artrealm-image-1314455608
COS_BUCKET=artrealm-image-1314455608
# COS 所在地域，例如 ap-beijing
COS_REGION=ap-beijing

# 对外访问用的公网域名（你为 COS 配的自定义 CDN 域名），末尾不要带 /
PUBLIC_BASE_URL=https://abc.nextmak.cn

# COS 内的存储目录前缀
COS_PREFIX=seedance-uploads

# 上传鉴权 token：随便设一串随机字符串，前端 .env 的 VITE_UPLOAD_SERVICE_TOKEN 必须与此一致。
# 留空则不校验（不推荐，任何人都能调用你的上传接口）。
UPLOAD_TOKEN=换成一串随机字符串

# 允许的跨域来源，多个用逗号分隔，例如 https://artrealm.nextmak.cn
# - 留空（默认）：仅允许本机（localhost/127.0.0.1）与局域网私有网段来源，适合本地开发；
# - 设为 *：允许所有来源（不安全，不推荐）；
# - 生产环境请填写你的站点域名，例如 https://artrealm.nextmak.cn
ALLOW_ORIGINS=https://artrealm.nextmak.cn

# 单张图片体积上限（MB）
MAX_FILE_MB=15

# 单个参考音频体积上限（MB）
MAX_AUDIO_MB=30

# 单个参考视频体积上限（MB）
MAX_VIDEO_MB=50

# 每个 IP 每分钟最多上传次数（防刷）。
# Seedance 2.0 多图参考 + 批量生成会在一分钟内上传多张图，建议 60 起；
# 前端已缓存同一张图的上传结果，正常使用不会频繁触发。
UPLOAD_RATE_LIMIT_PER_MIN=60

# 每个 IP 每天最多上传字节数（MB，防 COS 额度盗刷；按需调整）
UPLOAD_DAILY_QUOTA_MB=1024

# 是否信任反向代理传入的 X-Forwarded-For（部署在 Nginx 后置为 1）
TRUST_PROXY=0

# COS 生命周期：seedance-uploads/ 下的对象在上传 N 天后自动删除。
# 注意事项：火山/阿里等上游抓取图片需要时间，且返回给用户的 URL 也会在 N 天后失效，
# 建议 >= 1 天（本项目默认 3 天）。上传服务启动后每小时自动清理；
# 原生 COS 生命周期规则可用时运行 npm run lifecycle 生效。
LIFECYCLE_EXPIRE_DAYS=3
