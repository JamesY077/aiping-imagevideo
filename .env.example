VITE_APP_NAME=ArtRealm AI
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api/v1
VITE_API_DOCS_URL=https://aiping.cn/docs

# ===== 参考文件上传服务（可选，仅 Seedance 2 本地参考视频需要）=====
# 实测：Seedance 2 的参考图/参考音频、MiniMax-H3 的图/视频/音频都能用 dataURI 直传；
# 只有火山 Seedance 2 的 reference_video 只接受公网 URL，本地视频必须先换成公网地址。
# 不配置时其余场景全部正常，仅「Seedance + 本地视频」会提示改用公网视频地址。
# 部署见 server/upload-service 与 DEPLOYMENT.md 第七节。
VITE_UPLOAD_SERVICE_URL=https://artrealm.nextmak.cn/upload
# 与 server/upload-service 的 UPLOAD_TOKEN 保持一致
VITE_UPLOAD_SERVICE_TOKEN=

# 静态图片 CDN/COS 前缀：本地开发留空走 public/，生产填 COS 或 CDN 地址
VITE_CDN_ASSET_BASE=
