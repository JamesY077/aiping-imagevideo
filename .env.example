VITE_APP_NAME=ArtRealm AI
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api/v1
VITE_API_DOCS_URL=https://aiping.cn/docs

# ===== Seedance 2.0 参考图上传服务（可选）=====
# 火山 Seedance 2.0 的 CreateAsset 只接受公网 URL，不接受本地 base64。
# 本地上传的参考图会先 POST 到该服务换成公网 URL 再交给火山。
# 部署见 server/upload-service。不配置则 Seedance 2.0 无法使用本地上传图。
VITE_UPLOAD_SERVICE_URL=https://artrealm.nextmak.cn/upload
# 与 server/upload-service 的 UPLOAD_TOKEN 保持一致
VITE_UPLOAD_SERVICE_TOKEN=

