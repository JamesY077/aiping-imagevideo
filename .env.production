VITE_API_BASE_URL=/api/v1
# 参考文件上传服务（图片 / 音频 / 视频）。
# - 图片：Seedance 会先尝试上传换公网 URL；上传服务不可用时自动降级为压缩后的 base64 dataURI。
# - 视频 / 音频：上游只接受公网 URL，必须依赖该服务，因此部署 server/upload-service
#   并给线上 Nginx 加 /upload 反代后才能使用本地视频/音频参考（见 DEPLOYMENT.md）。
VITE_UPLOAD_SERVICE_URL=/upload
# 注意：该 token 会打进前端产物，属公开值；服务端 UPLOAD_TOKEN 必须与之一致。
VITE_UPLOAD_SERVICE_TOKEN=0eeed6cbe12778920fcfe9bd75eefefac0ea371b4586727f

# 静态图片走 COS 公有读直连；CDN 加速域名生效后替换为：
# https://cdn.artrealm.nextmak.cn/site-assets
VITE_CDN_ASSET_BASE=https://artrealm-image-1314455608.cos.ap-beijing.myqcloud.com/site-assets
